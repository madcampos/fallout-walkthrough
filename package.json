	"version": "1.0.0",
	"private": true,
	"description": "Fallout 2 Walkthrough",
	"keywords": [],
	"engines": {
		"node": ">=26.4.0",
		"pnpm": ">=11.11.0"
	},
	"author": {
		"name": "madcampos",
