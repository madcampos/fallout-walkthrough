		"update": "update",
		"deploy": "wrangler deploy --minify --env=\"\""
	},
	"devDependencies": {
		"@mad-c/config": "^3.2.0",
		"dprint": "^0.55.2",
		"oxlint": "^1.77.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2",
		"wrangler": "4.119.0"
	}
}
